# ============================================================================
# Chujai Legal — Environment Variables
# ============================================================================
# Copy this file to `.env.local` (never commit real secrets).
# Every integration degrades gracefully to a local mock when its key is unset,
# so the app builds and runs with NO keys configured.

# ----------------------------------------------------------------------------
# AI Engine — DeepSeek (OpenAI-compatible chat completions)
# ----------------------------------------------------------------------------
# Get a key at https://platform.deepseek.com (or use OpenRouter by overriding
# DEEPSEEK_BASE_URL to https://openrouter.ai/api/v1 and a suitable model id).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ----------------------------------------------------------------------------
# Supabase (PostgreSQL) — https://supabase.com
# ----------------------------------------------------------------------------
# Browser-facing (inlined into the client bundle):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (privileged operations):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# LINE — Messaging API + LINE Login — https://developers.line.biz
# ----------------------------------------------------------------------------
# Messaging API channel access token (push/reply/broadcast):
LINE_CHANNEL_TOKEN=

# LINE Login (OAuth 2.1):
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=https://chujai.legal/api/auth/line

# ----------------------------------------------------------------------------
# Omise — Thai payment gateway — https://www.omise.co
# ----------------------------------------------------------------------------
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# Optional: shared secret used to HMAC-verify webhook payloads:
OMISE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
